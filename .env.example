TAVILY_API_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Azure AI Search
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX_NAME=financial-document-chunks-v1

# LangSmith observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=financial-intelligence-copilot-dev


# Required only when one API key can access multiple workspaces.
# LANGSMITH_WORKSPACE_ID=

# Set only when the LangSmith account is hosted in the EU region.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Local PostgreSQL container
POSTGRES_DB=ficopilot
POSTGRES_USER=ficopilot
POSTGRES_PASSWORD=change-me-for-local-development

# Used by database initialization and seed scripts.
DATABASE_URL=postgresql+psycopg://ficopilot:change-me-for-local-development@127.0.0.1:5433/ficopilot

# Used by the live Data Agent.
# Locally it uses the same connection. In production this should be a read-only user.
DATA_AGENT_DATABASE_URL=postgresql+psycopg://ficopilot:change-me-for-local-development@127.0.0.1:5433/ficopilot

# Set by the production container to serve the React build from FastAPI.
# FRONTEND_DIST_DIR=/app/frontend-dist

# Used by the document ingestion registry.
# Locally it uses the same development database user.
# Production uses a dedicated limited writer role.
DOCUMENT_REGISTRY_DATABASE_URL=postgresql+psycopg://ficopilot:change-me-for-local-development@127.0.0.1:5433/ficopilot